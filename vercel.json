{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/cbt.js": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": [
        "server/_vercel-bundle.mjs",
        "node_modules/better-sqlite3/**"
      ]
    },
    "api/index.js": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": [
        "server/_vercel-bundle.mjs",
        "node_modules/better-sqlite3/**"
      ]
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/(.*)",
      "destination": "/api/cbt.js?__vercel_path=auth/$1"
    },
    {
      "source": "/api/admin/(.*)",
      "destination": "/api/cbt.js?__vercel_path=admin/$1"
    },
    {
      "source": "/api/student/(.*)",
      "destination": "/api/cbt.js?__vercel_path=student/$1"
    },
    {
      "source": "/api/public/(.*)",
      "destination": "/api/cbt.js?__vercel_path=public/$1"
    },
    {
      "source": "/api/health",
      "destination": "/api/cbt.js?__vercel_path=health"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/cbt.js?__vercel_path=uploads/$1"
    },
    {
      "source": "/((?!api/|uploads/).*)",
      "destination": "/index.html"
    }
  ]
}
