# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# ==========================================================
# KONFIGURASI DATABASE SUPABASE (WAJIB UNTUK PRODUKSI)
# ==========================================================
# URL proyek Supabase (mis. https://xyzcompany.supabase.co)
SUPABASE_URL=""
# Public Anon Key Supabase (aman untuk frontend dengan RLS aktif)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
# Service Role Key Supabase (RAHASIA - HANYA UNTUK SERVER, JANGAN PERNAH EKSPOS KE FRONTEND)
SUPABASE_SERVICE_ROLE_KEY=""

# ==========================================================
# KEAMANAN & SESI SERVER
# ==========================================================
# Kunci rahasia penandatanganan JWT sesi server (gunakan string acak panjang di produksi)
JWT_SECRET="ganti-dengan-kunci-rahasia-jwt-minimal-32-karakter"
# Port server Express + Vite
PORT="3000"
